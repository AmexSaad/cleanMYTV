+  <string name="home_tv_changes_note">Tetapan yang ditukar pada TV itu sendiri diganti apabila anda menghantar dari sini.</string>
+  <!-- look2 Look row: what was last sent, then how many apps in a row -->
+  <string name="home_row_look_summary_picture">{style} dengan {picture}</string>
+  <string name="home_row_look_summary_photo">{style} dengan foto anda</string>
