+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Clean Your TV, :feature:setup. English source strings.
+  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
+  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
+  no Android plurals elements. Counts go through the plural selector.
+  Screens: probing, S3, S3a, S3b, S4a, S4b, S4c, S4d, S4e, install failure, S5 Done, restart flow,
+  credential prompt, foreground notification. Strings that contain a percent sign are marked
+  formatted="false" so lint does not read them as printf.
+-->
+<resources>
+  <!-- Shared button words -->
+  <string name="action_back">Kembali</string>
+  <string name="action_cancel">Batal</string>
+  <string name="action_ok">OK</string>
+  <string name="action_done">Selesai</string>
+  <string name="action_undo">Pulihkan</string>
+  <!-- Credential prompt (D17) -->
+  <string name="gate_title">Sahkan itu anda</string>
+  <string name="gate_subtitle">Sebelum kita menukar apa-apa pada {tv}</string>
+  <string name="gate_negative">Batal</string>
+  <string name="gate_failed">Kami tidak dapat mengesahkan itu adalah anda, jadi tiada apa-apa yang diubah.</string>
+  <!-- Notifications (D18, D16) -->
+  <string name="notify_channel_name">Menyediakan TV</string>
+  <string name="notify_channel_description">Menunjukkan kemajuan semasa telefon menukar perkara pada TV anda dan memberitahu anda masa untuk melihat TV.</string>
+  <string name="notify_progress" formatted="false">Menyediakan {tv}, {percent}%</string>
